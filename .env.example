# --- Gemini via Vertex AI (bills against your GCP credits) ---
# Option A (recommended): project + `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Option B: Vertex AI express-mode API key (leave blank to use option A)
VERTEX_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Pacing / limits ---
MAX_PROFILE_VISITS_PER_DAY=50
MAX_VISITS_PER_AD=15
MAX_LIKERS_PER_AD=60
SESSION_MINUTES=25
